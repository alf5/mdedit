pkgbase = mdedit
	pkgdesc = A WYSIWYG Markdown editor built with Tauri and Leptos
	pkgver = 0.1.7
	pkgrel = 1
	url = https://github.com/alf5/mdedit
	install = mdedit.install
	arch = x86_64
	arch = aarch64
	license = MIT
	depends = cairo
	depends = desktop-file-utils
	depends = gdk-pixbuf2
	depends = glib2
	depends = gtk3
	depends = hicolor-icon-theme
	depends = libsoup3
	depends = pango
	depends = webkit2gtk-4.1
	options = !strip
	options = !debug

pkgname = mdedit
