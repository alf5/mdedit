[Desktop Entry]
Categories=Utility;TextEditor;
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} {{exec_arg}}
Icon={{icon}}
Name={{name}}
GenericName=Markdown Editor
Keywords=markdown;md;editor;notes;writing;
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}};text/x-markdown;
{{/if}}
StartupWMClass=mdedit
