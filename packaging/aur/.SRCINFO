pkgbase = mdedit
	pkgdesc = A Markdown editor that shows your writing, not your markup
	pkgver = 2.0.0
	pkgrel = 1
	url = https://github.com/alf5/mdedit
	install = mdedit.install
	arch = x86_64
	arch = aarch64
	license = MIT
	makedepends = cargo
	depends = libxcb
	depends = libxkbcommon
	depends = libxkbcommon-x11
	depends = wayland
	depends = vulkan-icd-loader
	depends = fontconfig
	depends = hicolor-icon-theme
	depends = desktop-file-utils
	options = !strip
	options = !debug
	options = !lto

pkgname = mdedit
