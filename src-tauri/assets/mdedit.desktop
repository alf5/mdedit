[Desktop Entry]
Categories=Office;TextEditor;
{{#if comment}}Comment={{comment}}{{/if}}
# WebKitGTK's DMA-BUF renderer draws a blank window under some Wayland
# compositors and drivers; the launcher cannot inherit the workaround from a
# shell profile, so set it here.
Exec=env WEBKIT_DISABLE_DMABUF_RENDERER=1 {{exec}} %f
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}MimeType={{mime_type}}{{/if}}
StartupWMClass=mdedit
