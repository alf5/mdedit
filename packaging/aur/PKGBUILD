# Maintainer: alf5
#
# Builds mdedit from this repository's working tree. Nothing is downloaded
# beyond the crates Cargo fetches, and no AUR remote is involved:
#
#   cd packaging/aur
#   makepkg -f          # add -i to install the result
#
# Keep pkgver in sync with the workspace version in ../../Cargo.toml.
pkgname=mdedit
pkgver=2.1.0
pkgrel=1
pkgdesc="A Markdown editor that shows your writing, not your markup"
arch=('x86_64' 'aarch64')
url="https://github.com/alf5/mdedit"
license=('MIT')
# libxcb and libxkbcommon are linked; Wayland, Vulkan and fontconfig are
# loaded at run time.
depends=('libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader'
  'fontconfig' 'hicolor-icon-theme' 'desktop-file-utils')
makedepends=('cargo')
# The release profile already strips the binary.
options=('!strip' '!debug' '!lto')
install=${pkgname}.install

# makepkg only resolves local sources that sit next to the PKGBUILD, so the
# build reads the repository directly instead.
source=()
sha256sums=()

_repodir="${startdir}/../.."

build() {
  cd "$_repodir"
  cargo build --release --locked -p mdedit
}

package() {
  cd "$_repodir"
  install -Dm755 target/release/mdedit "$pkgdir/usr/bin/mdedit"
  install -Dm644 packaging/linux/mdedit.desktop \
    "$pkgdir/usr/share/applications/mdedit.desktop"
  install -Dm644 assets/icons/32x32.png \
    "$pkgdir/usr/share/icons/hicolor/32x32/apps/mdedit.png"
  install -Dm644 assets/icons/128x128.png \
    "$pkgdir/usr/share/icons/hicolor/128x128/apps/mdedit.png"
  install -Dm644 assets/icons/256x256.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/mdedit.png"
  install -Dm644 assets/icons/512x512.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/mdedit.png"
  # MIT is not among the licenses the licenses package ships.
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
